+.account-table th:nth-child(2) { width: 115px; }
+.account-table th:nth-child(3) { width: 170px; }
+.account-table th:nth-child(4), .account-table th:nth-child(5), .account-table th:nth-child(6) { width: 105px; }
+.account-table th:nth-child(7), .account-table th:nth-child(8) { width: 112px; }
+.account-table th:nth-child(9) { width: 120px; }
+.account-table th:nth-child(10) { width: 150px; }
+.account-status { display: inline-flex !important; width: fit-content; padding: 3px 7px; border: 1px solid currentColor; font-size: 10px !important; font-weight: 700; }
+.account-status.ok { color: var(--ui-success); }
+.account-status.bad { color: var(--ui-danger); }
+.account-row-actions { display: flex; align-items: center; gap: 5px; }
+.account-row-actions .icon-button { width: 32px; height: 32px; }
+.account-test-result { max-width: 145px; }
+.account-test-result.ok { color: var(--ui-success) !important; }
+.account-test-result.bad { color: var(--ui-danger) !important; }
+.account-table-empty { min-height: 110px; display: flex; align-items: center; justify-content: center; gap: 8px; color: var(--ui-text-muted); }
+.account-pagination { min-height: 52px; padding: 9px 18px; display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--ui-text-muted); font-size: 11px; }
+.account-pagination > div { display: flex; gap: 5px; }
+.account-pagination .icon-button { width: 32px; height: 32px; }
+
+@media (max-width: 900px) {
+  .account-management-head { align-items: stretch; flex-direction: column; }
+  .account-management-actions { justify-content: stretch; flex-wrap: wrap; }
+  .account-search { width: min(100%, 320px); flex: 1 1 220px; }
+  .account-management-actions select { flex: 1 1 120px; }
+  .account-table { min-width: 1080px; }
+  .account-pagination { align-items: flex-start; flex-direction: column; }
+  .account-pagination > div { align-self: flex-end; }
+}
