+.account-usage-stack-meta { min-height: var(--account-primary-rail); display: flex; align-items: center; justify-content: space-between; gap: 9px; color: var(--ui-text-muted); line-height: 1.2; }
 .account-usage-source-tag { min-height: 22px; padding: 2px 6px; display: inline-flex; align-items: center; gap: 4px; color: var(--ui-text-muted); background: var(--ui-surface-muted); border: 1px solid var(--ui-border-soft); border-radius: 4px; font-size: 11px; font-weight: 750; white-space: nowrap; }
 .account-usage-source-tag.live { color: var(--ui-success); background: color-mix(in srgb, var(--ui-success) 7%, var(--ui-surface)); border-color: color-mix(in srgb, var(--ui-success) 30%, var(--ui-border)); }
