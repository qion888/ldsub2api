index 0000000..85973d5
--- /dev/null
+++ b/frontend/src/sub2apiCardPolling.js
@@ -0,0 +1,105 @@
+export const CARD_RECLAIM_POLL_INTERVAL_MS = 5000;
+export const CARD_RECLAIM_POLL_TIMEOUT_MS = 60000;
+export const CARD_RECLAIM_POLL_TIMEOUT_SECONDS = CARD_RECLAIM_POLL_TIMEOUT_MS / 1000;
+
+const count = value => {
+  const number = Number(value || 0);
+  return Number.isFinite(number) && number > 0 ? number : 0;
+};
+
+const progressPayload = response => {
+  if (!response || typeof response !== 'object') return {};
+  return response.result && typeof response.result === 'object' ? response.result : response;
+};
+
+export function summarizeReclaimProgress(response, downloadedCount = 0) {
+  const progress = progressPayload(response);
+  const tasks = Array.isArray(progress.all_tasks) ? progress.all_tasks : [];
+  const activeTasks = count(progress.queued) + count(progress.already_running);
+  const doneTasks = Math.max(count(progress.done), tasks.filter(task => task?.status === 'done').length);
+  const terminalTasks = count(progress.failed) + count(progress.unreclaimable) + count(progress.not_owned) + count(progress.skipped);
+  const trackedTasks = Math.max(count(progress.tracked_tasks), tasks.length, activeTasks + doneTasks + terminalTasks);
+  return {
+    progress,
+    activeTasks,
+    doneTasks,
+    terminalTasks,
+    trackedTasks,
+    downloadedCount,
+    completed: activeTasks === 0 && downloadedCount > 0 && (doneTasks === 0 || downloadedCount >= doneTasks),
+    terminal: activeTasks === 0 && downloadedCount === 0 && doneTasks === 0 && terminalTasks > 0,
+  };
+}
+
+export async function pollForReclaimDownloads({
+  initialResponse,
+  requestProgress,
+  onSnapshot = () => {},
+  intervalMs = CARD_RECLAIM_POLL_INTERVAL_MS,
+  timeoutMs = CARD_RECLAIM_POLL_TIMEOUT_MS,
+  now = () => Date.now(),
+  sleep = milliseconds => new Promise(resolve => globalThis.setTimeout(resolve, milliseconds)),
+}) {
+  if (typeof requestProgress !== 'function') throw new TypeError('requestProgress 必须是函数');
+  const startedAt = now();
+  const downloads = new Map();
+  let response = initialResponse || {};
+  let attempts = 0;
+  let lastError = null;
+
+  const rememberDownloads = values => (Array.isArray(values) ? values : []).forEach(item => {
+    const orderNo = item?.task?.order_no || item?.filename;
+    if (orderNo && item?.data) downloads.set(String(orderNo), item);
+  });
+
+  rememberDownloads(response.downloaded_payloads);
+  while (true) {
+    const elapsedMs = Math.max(0, now() - startedAt);
+    const snapshot = {
+      ...summarizeReclaimProgress(response, downloads.size),
+      attempts,
+      elapsedMs,
+      downloads: [...downloads.values()],
+      lastError,
+    };
+    onSnapshot(snapshot);
+    if (snapshot.completed || snapshot.terminal) {
+      return {...snapshot, timedOut: false};
+    }
+    if (elapsedMs >= timeoutMs) {
+      return {...snapshot, timedOut: true};
+    }
+
+    await sleep(Math.min(intervalMs, timeoutMs - elapsedMs));
+    try {
+      response = await requestProgress();
+      attempts += 1;
+      lastError = null;
+      rememberDownloads(response?.downloaded_payloads);
+    } catch (error) {
+      attempts += 1;
+      lastError = error;
+    }
+  }
+}
+
+export function reclaimPollingFailureMessage(result) {
+  if (result?.terminal) {
+    const progress = result.progress || {};
+    const details = [
+      ['失败', progress.failed],
+      ['不可找回', progress.unreclaimable],
+      ['未归属', progress.not_owned],
+      ['已跳过', progress.skipped],
+    ].filter(([, value]) => count(value) > 0).map(([label, value]) => `${label} ${count(value)}`);
+    return `找回任务已结束，但没有生成可导入 JSON${details.length ? `（${details.join('、')}）` : ''}`;
+  }
+  if (result?.activeTasks > 0) {
+    return `找回处理超过 1 分钟，仍有 ${result.activeTasks} 个任务处理中，可稍后重试`;
+  }
+  if (result?.downloadedCount > 0 && result?.doneTasks > result.downloadedCount) {
+    return `已下载 ${result.downloadedCount}/${result.doneTasks} 个账号 JSON，等待剩余文件超过 1 分钟，可稍后重试`;
+  }
+  const lastError = result?.lastError?.message ? `，最近一次查询失败：${result.lastError.message}` : '';
+  return `卡密核验已完成，但等待可下载的账号 JSON 超过 1 分钟${lastError}`;
+}
